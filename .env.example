# Copy to .env. Never commit .env.
TAVILY_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Where the Streamlit app reaches the gateway (compose service name inside Docker, localhost outside)
BIFROST_URL=http://localhost:8080
# Bifrost Virtual Keys (Tenant Authentication & Isolation - long random secrets)
CHRONO_VK_ALPHA=sk-bf-alpha-replace-with-random-secret
CHRONO_VK_BETA=sk-bf-beta-replace-with-random-secret
# Provider/model string exactly as Bifrost lists it. Verify with: curl $BIFROST_URL/v1/models
CHRONO_MODEL=gemini-2.5-flash

# live = real Tavily calls. replay = read fixtures/tavily/*.json (offline demo, deterministic).
CHRONO_TAVILY_MODE=live
CHRONO_WINDOW_DAYS=30
CHRONO_PROMPT_VERSION=brief-v1

# Cache policy (read by the plugin through config.json, mirrored here for the app's metrics panel)
CHRONO_CACHE_TTL_SECONDS=86400
CHRONO_CACHE_SET_POLICY=exact_set
CHRONO_AUDIT_LOG=./data/audit/freshcache.jsonl
